SPRING_PROFILES_ACTIVE=local
DEVPATH_DB_URL=jdbc:postgresql://localhost:5432/devpath
DEVPATH_DB_USERNAME=devpath
DEVPATH_DB_PASSWORD=replace-with-local-password
GITHUB_CLIENT_ID=replace-with-github-oauth-client-id
GITHUB_CLIENT_SECRET=replace-with-github-oauth-client-secret
GITHUB_INTEGRATION_CLIENT_ID=replace-with-github-app-client-id
GITHUB_INTEGRATION_CLIENT_SECRET=replace-with-github-app-client-secret
GITHUB_INTEGRATION_REDIRECT_URI=http://localhost:8080/api/v1/integrations/github/callback
DEVPATH_PROVIDER_CREDENTIAL_KEY=replace-with-base64-encoded-32-byte-key
DEVPATH_PROVIDER_CREDENTIAL_KEY_VERSION=local-v1
DEVPATH_FRONTEND_ORIGIN=http://localhost:5173
DEVPATH_SESSION_COOKIE_NAME=DEVPATH_SESSION
DEVPATH_SESSION_COOKIE_SECURE=false
DEVPATH_SESSION_IDLE_TIMEOUT=30m
DEVPATH_SESSION_ABSOLUTE_TIMEOUT=12h
DEVPATH_POST_LOGIN_REDIRECT=/
DEVPATH_WORKER_ENABLED=true
DEVPATH_REPOSITORY_SYNC_POLL_INTERVAL=1000
DEVPATH_REPOSITORY_SYNC_INITIAL_DELAY=1000
