SPRING_PROFILES_ACTIVE=local
DEVPATH_DB_URL=jdbc:postgresql://localhost:15432/devpath
DEVPATH_DB_USERNAME=devpath
DEVPATH_DB_PASSWORD=replace-with-local-password
GITHUB_CLIENT_ID=replace-with-github-oauth-client-id
GITHUB_CLIENT_SECRET=replace-with-github-oauth-client-secret
GITHUB_INTEGRATION_CLIENT_ID=replace-with-github-app-client-id
GITHUB_INTEGRATION_CLIENT_SECRET=replace-with-github-app-client-secret
GITHUB_INTEGRATION_REDIRECT_URI=http://localhost:8080/api/v1/integrations/github/callback
DEVPATH_GITHUB_CONNECT_TIMEOUT=5s
DEVPATH_GITHUB_READ_TIMEOUT=30s
NOTION_INTEGRATION_CLIENT_ID=replace-with-notion-public-integration-client-id
NOTION_INTEGRATION_CLIENT_SECRET=replace-with-notion-public-integration-client-secret
NOTION_INTEGRATION_REDIRECT_URI=http://localhost:8080/api/v1/integrations/notion/callback
DEVPATH_NOTION_CONNECT_TIMEOUT=5s
DEVPATH_NOTION_READ_TIMEOUT=30s
DEVPATH_PROVIDER_CREDENTIAL_KEY=replace-with-base64-encoded-32-byte-key
DEVPATH_PROVIDER_CREDENTIAL_KEY_VERSION=local-v1
DEVPATH_FRONTEND_ORIGIN=http://localhost:5100
DEVPATH_SESSION_COOKIE_NAME=DEVPATH_SESSION
DEVPATH_SESSION_COOKIE_SECURE=false
DEVPATH_SESSION_IDLE_TIMEOUT=30m
DEVPATH_SESSION_ABSOLUTE_TIMEOUT=12h
DEVPATH_POST_LOGIN_REDIRECT=/
DEVPATH_WORKER_ENABLED=true
DEVPATH_WORKER_SHUTDOWN_TIMEOUT=10m
DEVPATH_REPOSITORY_SYNC_POLL_INTERVAL=1000
DEVPATH_REPOSITORY_SYNC_INITIAL_DELAY=1000
DEVPATH_KNOWLEDGE_POLL_INTERVAL=1000
DEVPATH_KNOWLEDGE_INITIAL_DELAY=2000
DEVPATH_OBJECT_STORAGE_ROOT=./.devpath/objects
DEVPATH_RETRIEVAL_MINIMUM_RELEVANCE=0.25
DEVPATH_EMBEDDING_BASE_URL=http://localhost:11434
DEVPATH_EMBEDDING_MODEL=nomic-embed-text
DEVPATH_EMBEDDING_MODEL_VERSION=nomic-embed-text
DEVPATH_EMBEDDING_DIMENSION=768
DEVPATH_EMBEDDING_CONNECT_TIMEOUT=5s
DEVPATH_EMBEDDING_READ_TIMEOUT=60s
DEVPATH_AI_BASE_URL=http://localhost:11434
DEVPATH_AI_MODEL=qwen2.5:7b
DEVPATH_AI_CONNECT_TIMEOUT=5s
DEVPATH_AI_READ_TIMEOUT=90s
DEVPATH_AI_MAX_ATTEMPTS=2
DEVPATH_AI_POLL_INTERVAL=1000
DEVPATH_AI_INITIAL_DELAY=2500
